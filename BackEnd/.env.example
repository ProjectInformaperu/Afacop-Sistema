# Radar 360 Backend - plantilla de produccion para Render
# Copie los valores al panel Environment de Render. Nunca confirme un .env real.

# Infraestructura
NODE_ENV=production
# Render inyecta PORT automaticamente; este valor sirve para ejecucion local.
PORT=4000
# SECRETO: URL de PostgreSQL con TLS (?sslmode=require).
DATABASE_URL=
# Servicio publico de geocodificacion; no es un secreto.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Criptografia y autenticacion
# SECRETOS: aleatorios, diferentes entre si y con 32 caracteres como minimo.
# El Blueprint de Render los genera automaticamente mediante generateValue.
JWT_SECRET=
MFA_ENCRYPTION_KEY=
# SECRETO de un solo uso para crear el primer administrador si la BD esta vacia.
INITIAL_ADMIN_USERNAME=Afacop
INITIAL_ADMIN_PASSWORD=@InformaPeru2026
# Recuperacion excepcional: habilitar solo durante un despliegue y volver a false.
RESET_INITIAL_ADMIN=false
REQUIRE_MFA=true
JWT_EXPIRES_IN=15m
JWT_ISSUER=radar-360-api
JWT_AUDIENCE=radar-360-clients
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCK_MINUTES=15

# Red y navegador
# URL HTTPS exacta del frontend, sin slash final. Para varios origenes use comas.
FRONTEND_URL=https://afacop-frontend.onrender.com
# Nunca habilitar en produccion.
CORS_ALLOW_ALL=false
# Render opera detras de un proxy inverso.
TRUST_PROXY=true

# Observabilidad: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info
